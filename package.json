{
  "name": "upstack",
  "version": "1.0.0",
  "description": "Export Markdown to Substack-compatible HTML",
  "main": "main.js",
  "type": "module",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
    "version": "node version-bump.mjs && git add manifest.json versions.json"
  },
  "keywords": ["obsidian", "plugin", "substack", "markdown"],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@types/marked": "^5.0.2",
    "@types/node": "^20.0.0",
    "builtin-modules": "3.3.0",
    "esbuild": "0.19.8",
    "obsidian": "latest",
    "tslib": "2.4.1",
    "typescript": "5.3.3"
  },
  "dependencies": {
    "marked": "^17.0.1"
  }
}
